# Any OpenAI-compatible endpoint serving a vision model.

# Option 1: Local Ollama (default) -> ollama pull qwen2.5vl:7b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5vl:7b
AI_API_KEY=ollama

# Option 2: OpenRouter (recommended for cloud/Render deployments)
# An open-weight vision model hosted on OpenRouter (e.g. Qwen2.5-VL)
# AI_BASE_URL=https://openrouter.ai/api/v1
# AI_MODEL=qwen/qwen-2.5-vl-7b-instruct
# AI_API_KEY=<your-openrouter-api-key>

# Option 3: Google Gemini (OpenAI-compatible endpoint)
# Note: Google's OpenAI endpoint supports Gemini models (not Gemma)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=gemini-1.5-flash
# AI_API_KEY=<your-gemini-api-key>

# Option 4: Together AI (Open-weight vision model)
# AI_BASE_URL=https://api.together.xyz/v1
# AI_MODEL=meta-llama/Llama-3.2-11B-Vision-Instruct-Turbo
# AI_API_KEY=<your-together-api-key>

# Optional server configuration
# PORT=3000
# RATE_LIMIT_PER_MIN=8
