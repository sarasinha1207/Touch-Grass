# Any OpenAI-compatible endpoint serving an open-weight vision model.

# Local (default): Ollama   ->  ollama pull qwen2.5vl:7b
AI_BASE_URL=http://localhost:11434/v1
AI_MODEL=qwen2.5vl:7b
AI_API_KEY=ollama

# Hosted example (for Render): an open-weight VLM from a provider such as
# Hugging Face or OpenRouter. Check the provider's catalogue for the exact model id.
# AI_BASE_URL=https://router.huggingface.co/v1
# AI_MODEL=<open-weight vision model id>
# AI_API_KEY=<your token>

# Optional
# RATE_LIMIT_PER_MIN=8
